<mujoco model="line_follower">
  <!-- Python fills dimensions, masses, sites, and actuator limits from RobotConfig. -->
  <compiler angle="radian"/>
  <option timestep="0.001666666666666667" integrator="implicitfast" gravity="0 0 -9.81" cone="elliptic"/>
  <visual><global offwidth="1200" offheight="900"/><headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4"/></visual>
  <default><geom solref="0.008 1" solimp="0.95 0.99 0.001"/><joint damping="0.00001"/></default>
  <worldbody>
    <light pos="0 0 4" directional="true" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="1 1 1 1"/>
    <body name="chassis" pos="0 0 0.033">
      <freejoint name="root"/>
      <geom name="chassis_geom" type="box" pos="-0.025 0 0" size="0.075 0.065 0.0125" mass="0.45" rgba="0.12 0.27 0.43 1"/>
      <geom name="heading" type="capsule" fromto="0 0 0.018 0.06 0 0.018" size="0.003" contype="0" conaffinity="0" mass="0" rgba="1 0.5 0 1"/>
      <geom name="sensor_board" type="box" pos="0.043 0 -0.024" size="0.016 0.04 0.0015" mass="0.04" contype="0" conaffinity="0" rgba="0.1 0.55 0.3 0.7"/>
      <body name="left_wheel" pos="0 0.0875 -0.0165">
        <joint name="left_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_tire" type="cylinder" size="0.0165 0.006" quat="0.7071067812 0.7071067812 0 0" mass="0.025" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.0875 -0.0165">
        <joint name="right_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_tire" type="cylinder" size="0.0165 0.006" quat="0.7071067812 0.7071067812 0 0" mass="0.025" rgba="0.08 0.08 0.08 1"/>
      </body>
      <body name="caster" pos="-0.075 0 -0.027">
        <joint name="caster_joint" type="ball" damping="0.000001"/>
        <geom name="caster_ball" type="sphere" size="0.006" mass="0.01" rgba="0.7 0.7 0.75 1"/>
      </body>
    </body>
  </worldbody>
  <!-- Explicit pairs avoid floor friction overriding caster friction via max mixing. -->
  <contact>
    <pair name="left_floor" geom1="floor" geom2="left_tire" condim="4" friction="0.75 0.75 0.0001 0.00001 0.00001"/>
    <pair name="right_floor" geom1="floor" geom2="right_tire" condim="4" friction="0.75 0.75 0.0001 0.00001 0.00001"/>
    <pair name="caster_floor" geom1="floor" geom2="caster_ball" condim="3" friction="0.05 0.05 0.00001 0.000001 0.000001"/>
  </contact>
  <actuator>
    <general name="left_motor" joint="left_joint" gear="1" dyntype="filterexact" dynprm="0.05" gaintype="fixed" gainprm="0.005" biastype="affine" biasprm="0 0 -0.005" ctrllimited="true" ctrlrange="-18.181818 18.181818" forcelimited="true" forcerange="-0.03 0.03"/>
    <general name="right_motor" joint="right_joint" gear="1" dyntype="filterexact" dynprm="0.05" gaintype="fixed" gainprm="0.005" biastype="affine" biasprm="0 0 -0.005" ctrllimited="true" ctrlrange="-18.181818 18.181818" forcelimited="true" forcerange="-0.03 0.03"/>
  </actuator>
</mujoco>
